{
  "name": "little-by-little",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:production": "npm run build && playwright test --config playwright.production.config.ts",
    "test:online": "playwright test --config playwright.online.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audio:generate": "node scripts/generate-audio.ts"
  },
  "dependencies": {
    "lucide-react": "1.53.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "prettier": "^3.8.5",
    "typescript": "^5.9.0",
    "vite": "8.3.4",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
